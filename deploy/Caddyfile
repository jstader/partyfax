{
	# rate_limit is a plugin (deploy/caddy/Dockerfile), so Caddy has no
	# built-in place for it among the other handlers.
	order rate_limit before basic_auth

	# TLS ends at Cloudflare; cloudflared hands requests in as plain HTTP
	# over the compose network. Nothing publishes a port, so there is no
	# certificate to get and nothing to redirect.
	auto_https off

	servers {
		# Every connection comes from cloudflared, so the peer address is
		# always the same container. The visitor is in Cf-Connecting-IP,
		# trusted only from a private address: anything else reaching
		# Caddy could set the header to whatever it liked.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-IP
	}
}

# ---- shared by every site --------------------------------------------------

(edge) {
	encode gzip

	# The edge sees what no service does: static files, the broker websocket,
	# and anything refused before it reaches a service.
	log {
		output stdout
		format json
	}

	# FAX_BANNED from .env: space-separated IPs or CIDR ranges. Their
	# connections are closed with no response. Empty bans nobody.
	# client_ip, not remote_ip: the remote is always cloudflared.
	@banned client_ip {$FAX_BANNED}
	handle @banned {
		abort
	}

	# The page shows a refusal's "error" field, so say it in its words.
	# Prints and event codes both end up here.
	handle_errors 429 {
		header Content-Type application/json
		respond `{"error":"too many tries, wait a few minutes and try again"}` 429
	}
}

# The pages load nothing from anywhere else: no inline script or style,
# same-origin fetch and EventSource, images from the site, data: (icons) and
# blob: (photo previews, wall strips). So the policy can say exactly that.
# The JSON-LD block in index.html is data, not script, and is unaffected.
# The argument is the camera permission: none on the main site, the page
# itself on the photobooth.
(headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# No includeSubDomains: other nilanet.live names are LAN-only and
		# not all of them need to be HTTPS.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera={args[0]}, microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
}

# Browsers keep a file only as long as this says, so a deploy reaches
# visitors whole, never new app.js with old photo.js: no-cache means ask
# every time, and the ETag makes that a 304 when nothing changed. Fonts
# never change under the same name, so they are kept. The pages' URLs carry
# no version numbers, so this has to be what browsers see: Cloudflare's
# Browser Cache TTL must be "Respect Existing Headers" (deploy/README.md),
# or Cloudflare substitutes four hours on scripts and stylesheets.
(static_cache) {
	@font path /fonts/*
	@notfont not path /fonts/*
	header @font Cache-Control "public, max-age=31536000, immutable"
	header @notfont Cache-Control "no-cache"
}

# The visitor's address for the services' logs. The gateway logs the last
# X-Forwarded-For entry as the caller, and Caddy would append cloudflared's
# after the visitor's: one value, the trusted one, instead.
(forward_client) {
	header_up X-Forwarded-For {client_ip}
}

# ---- photobooth.nilanet.live ----------------------------------------------

# A more specific address than :80 below, so Caddy sends this host here.
http://photobooth.nilanet.live {
	import edge
	import headers (self)

	# Per visitor address, joining only, so event codes can't be guessed:
	# 10 tries a minute (the booth also counts wrong codes on every request).
	# Printing isn't limited: the code already keeps strangers out, a party's
	# guests often share one Wi-Fi address, and the printer takes one strip
	# at a time anyway.
	rate_limit {
		zone booth_join {
			match {
				method POST
				path /api/booth/join
			}
			key {client_ip}
			events 10
			window 1m
		}
	}

	# /api/booth/admin/* is behind Cloudflare Access at the edge, and the
	# booth checks the Access token again itself.
	handle /api/booth/* {
		reverse_proxy booth:8083 {
			import forward_client
		}
	}

	# The booth's pages live in the same tree as the main site's, under
	# /booth/, so they share js/photo.js and the fonts. Only those three
	# folders are served here; the main site's pages are not.
	handle {
		root * /srv/web
		rewrite / /booth/index.html
		rewrite /wall /booth/wall.html
		rewrite /strip /booth/strip.html
		rewrite /admin /booth/admin/index.html
		rewrite /admin/ /booth/admin/index.html

		@outside not path /booth/* /js/* /fonts/*
		respond @outside 404

		import static_cache
		file_server
	}
}

# ---- fortunes.nilanet.live ------------------------------------------------

http://fortunes.nilanet.live {
	import edge
	import headers ()

	# The same as the main site's, counted separately: per visitor address,
	# at most 10 slips a minute, 100 an hour and 200 a day.
	rate_limit {
		zone fortunes_minute {
			match {
				method POST
				path /api/fortune
			}
			key {client_ip}
			events 10
			window 1m
		}
		zone fortunes_hour {
			match {
				method POST
				path /api/fortune
			}
			key {client_ip}
			events 100
			window 1h
		}
		zone fortunes_day {
			match {
				method POST
				path /api/fortune
			}
			key {client_ip}
			events 200
			window 24h
		}
	}

	# Printing a slip and nothing else of the gateway's.
	handle /api/fortune {
		reverse_proxy gateway:8080 {
			import forward_client
		}
	}

	handle /api/* {
		respond 404
	}

	# Like the booth: the pages under /fortunes/ in the shared tree, with the
	# shared js/ and fonts/, and nothing else of the main site.
	handle {
		root * /srv/web
		rewrite / /fortunes/index.html

		@outside not path /fortunes/* /js/* /fonts/*
		respond @outside 404

		import static_cache
		file_server
	}
}

# ---- partyfax.nilanet.live (any other host) --------------------------------

# Any Host: only cloudflared reaches this listener, and it sends only the
# hostnames the tunnel is configured for.
:80 {
	import edge
	import headers ()

	# Per visitor address, refused prints included: at most 10 a minute,
	# 100 an hour and 200 a day. A print has to fit all three. Everything else,
	# the page and the wall, is never limited.
	rate_limit {
		zone prints_minute {
			match {
				method POST
				path /api/print
			}
			key {client_ip}
			events 10
			window 1m
		}
		zone prints_hour {
			match {
				method POST
				path /api/print
			}
			key {client_ip}
			events 100
			window 1h
		}
		zone prints_day {
			match {
				method POST
				path /api/print
			}
			key {client_ip}
			events 200
			window 24h
		}
	}

	handle /mqtt* {
		reverse_proxy mosquitto:9001
	}

	# Fortune slips print from their own site, under its own limits.
	handle /api/fortune {
		respond 404
	}

	handle /api/* {
		reverse_proxy gateway:8080 {
			import forward_client
		}
	}

	handle {
		root * /srv/web
		# Clean page URLs: /prints serves prints.html.
		try_files {path} {path}.html

		# The photobooth's and the fortunes' pages belong to their own hosts,
		# and the tests and package.json are for development, not visitors.
		@notsite path /booth /booth/* /fortunes /fortunes/* /test/* /package.json
		respond @notsite 404

		import static_cache
		file_server
	}
}
