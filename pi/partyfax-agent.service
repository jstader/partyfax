[Unit]
Description=partyfax printer agent
Wants=network-online.target
After=network-online.target

[Service]
User=partyfax
# lp owns /dev/usb/lp0.
SupplementaryGroups=lp
EnvironmentFile=/etc/partyfax/agent.env
ExecStart=/usr/local/bin/partyfax-agent
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
