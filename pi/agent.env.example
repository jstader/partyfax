# /etc/partyfax/agent.env on the Pi: root-owned, mode 0640, group partyfax.
# Only PARTYFAX_MQTT_PASS is required; the rest show their defaults.

# The broker's `printer` account (deploy/mosquitto/passwd on the server).
PARTYFAX_MQTT_PASS=

# PARTYFAX_MQTT_URL=wss://partyfax.nilanet.live/mqtt
# PARTYFAX_MQTT_USER=printer
# Must match DEVICE_ID in the server's .env.
# PARTYFAX_DEVICE_ID=printer-1
# PARTYFAX_PRINTER=/dev/usb/lp0

# A Cloudflare Access service token, if Access protects /mqtt (see the
# Cloudflare Access section of pi/README.md). Both or neither.
# PARTYFAX_CF_ACCESS_CLIENT_ID=
# PARTYFAX_CF_ACCESS_CLIENT_SECRET=
