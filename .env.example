# Copy to .env and fill in. .env is gitignored -- never commit it.

MQTT_USERNAME=backend
MQTT_PASSWORD=

# The broker's `printer` account, which the Pi agent logs in as. Not read by
# any container: kept here so it is written down next to passwd.
PRINTER_MQTT_PASSWORD=

DEVICE_ID=printer-1

# The tunnel's token, from Cloudflare Zero Trust > Networks > Tunnels. Its
# public hostname (partyfax.nilanet.live) points at http://caddy:80.
CLOUDFLARE_TUNNEL_TOKEN=

# IPs or CIDR ranges Caddy drops, space-separated, matched against the
# visitor's address from Cloudflare. Apply with `docker compose up -d caddy`:
# Caddy reads it only at start.
# FAX_BANNED="203.0.113.9 198.51.100.0/24"

# The photobooth's admin page sits behind a Cloudflare Access application
# (deploy/README.md). The booth checks Access's token itself too, against
# these: the team domain (e.g. yourteam.cloudflareaccess.com) and the
# application's Audience (AUD) tag. Unset leaves admin closed.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
