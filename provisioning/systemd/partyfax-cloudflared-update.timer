# Weekly, mid-morning Pacific: well clear of the 03:15-03:35 nightly backup, and
# someone is likely around if it goes wrong.
[Unit]
Description=Weekly cloudflared update for partyfax

[Timer]
OnCalendar=Tue *-*-* 10:00:00 America/Los_Angeles
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
